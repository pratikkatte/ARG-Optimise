#!/bin/bash
#SBATCH --job-name=arg-gfn
#SBATCH --account=bbpa-delta-gpu
#SBATCH --partition=gpuA100x4
#SBATCH --array=1,2,4
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-node=1
#SBATCH --mem=100G
#SBATCH --time=48:00:00
#SBATCH --output=logs/train-%A_%a.out
#SBATCH --error=logs/train-%A_%a.err

set -euo pipefail

# Go to the directory from which you ran sbatch

cd /u/pratikkatte7/ARG-Optimise
# -------------------------------
# Environment
# -------------------------------

# CHANGE this to your actual conda environment

PYTHON=/u/pratikkatte7/.conda/envs/args/bin/python
echo "Working directory: $(pwd)"

echo "Python: $PYTHON"

$PYTHON --version
export PYTHONNOUSERSITE=1
export OMP_NUM_THREADS="$SLURM_CPUS_PER_TASK"

# Dataset for this array job: r1, r2, or r4
DATASET="r${SLURM_ARRAY_TASK_ID}"

echo "======================================"
echo "Job ID:       $SLURM_JOB_ID"
echo "Array ID:     $SLURM_ARRAY_TASK_ID"
echo "Dataset:      $DATASET"
echo "Node:         $(hostname)"
echo "Started:      $(date)"
echo "======================================"

echo
echo "=== GPU information ==="
nvidia-smi

echo
echo "=== Run lambda 1: ${DATASET} ==="

srun "$PYTHON" -u train.py \
    --config "config/paper_datasets/sub_lambda_1/${DATASET}.yaml"

echo
echo "=== Lambda 1 finished at $(date) ==="
echo
echo "=== Run lambda 2: ${DATASET} ==="

srun "$PYTHON" -u train.py \
    --config "config/paper_datasets/sub_lambda_2/${DATASET}.yaml"

echo
echo "=== Lambda 2 finished at $(date) ==="
echo "=== ALL DONE: ${DATASET} ==="
